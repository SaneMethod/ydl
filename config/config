# YT-DLP Config

# Authentication cookies refreshed by /usr/local/bin/youtube-login.py
--cookies "/config/youtube-cookies.txt"

# See https://github.com/lexiforest/curl-impersonate
--impersonate "chrome:windows-10"

# No caching to file system
--no-cache-dir

# Remove 8bit-unsafe filenames
--restrict-filenames

# Do not use the Last-modified header to set the file modification time
--no-mtime

# Make all connections via IPv4
--force-ipv4

# Set JS Runtimes (see: https://github.com/yt-dlp/yt-dlp/issues/14404)
--js-runtimes deno

# Set path to PO Token provider script
--extractor-args "youtubepot-bgutilscript:server_home=/usr/bin/pot/bgutil-ytdlp-pot-provider/server"
